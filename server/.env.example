# Copy this file to .env and fill in real values before running the project.

# The port the server runs on
PORT=3000

# A long, random, secret string used to sign admin login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# First administrator account. Created automatically the first time the
# server starts — see the README's "Set up Supabase" and "Run it" sections.
ADMIN_EMAIL=example@gmail.com
ADMIN_PASSWORD=change_this_password_now

# Supabase project credentials (Project Settings -> API in your Supabase
# dashboard). SUPABASE_SERVICE_KEY is the "service_role" secret key, not the
# public "anon" key — it must stay server-side only, never in a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Set to "production" when deploying for real (enables secure, HTTPS-only cookies)
NODE_ENV=development
