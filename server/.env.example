# Copy this file to .env and fill in real values before running the project.

# The port the server runs on
PORT=3000

# A long, random, secret string used to sign admin login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# First administrator account, created by running: npm run seed
ADMIN_EMAIL=manager@adanehotel.com
ADMIN_PASSWORD=change_this_password_now

# Set to "production" when deploying for real (enables secure, HTTPS-only cookies)
NODE_ENV=development
